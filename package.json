{
    "name": "vdj-db-manager",
    "description": "A safety-first desktop workspace for exploring and maintaining VirtualDJ libraries.",
    "private": true,
    "version": "0.1.0",
    "homepage": "https://gvastethecreator.github.io/vdj-manager/",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:pages": "tsc && vite build --mode pages --base=/vdj-manager/",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "lint": "oxlint src/",
        "lint:fix": "oxlint --fix src/",
        "tauri": "tauri",
        "check": "tsc --noEmit && oxlint src/",
        "deps:check": "bun outdated",
        "audit": "bun audit",
        "verify": "bun run check && bun run test && bun run build",
        "store:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/store/Test-StoreReadiness.ps1"
    },
    "dependencies": {
        "@tanstack/react-virtual": "^3.14.9",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@tauri-apps/plugin-fs": "^2.5.1",
        "@tauri-apps/plugin-shell": "^2.3.5",
        "lucide-react": "^1.31.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.11.2",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "oxlint": "^1.78.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.1"
    },
    "packageManager": "bun@1.3.14"
}
